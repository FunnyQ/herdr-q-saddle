      "options": [
        { "name": "Opus", "args": ["--model", "opus"], "effort": "medium" },
        { "name": "Sonnet", "args": ["--model", "sonnet"], "effort": "medium" }
      ]
    },
    {
      "name": "codex",
      "kind": "codex",
      "command": ["codex"],
      "efforts": ["low", "medium", "high"],
      "effort_args": ["-c", "model_reasoning_effort={effort}"],
      "options": [{ "name": "Default", "effort": "medium" }]
    },
    {
      "name": "opencode",
      "kind": "opencode",
      "command": ["opencode"]
    }
  ]
