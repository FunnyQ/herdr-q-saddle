{
  "default_tab_layout": "agentic-coding",
  "tab_layouts": [
    {
      "name": "agentic-coding",
      "label": "Agentic Coding",
      "panes": [
        { "name": "agent", "type": "agent" },
        {
          "name": "files",
          "type": "command",
          "command": "yazi .",
          "direction": "right",
          "ratio": 0.62
        },
        { "name": "term", "type": "shell", "direction": "down", "ratio": 0.1 }
      ]
    },
    {
      "name": "agent-only",
      "label": "Agent",
      "panes": [{ "name": "agent", "type": "agent" }]
    }
